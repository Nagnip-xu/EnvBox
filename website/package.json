{
  "name": "envbox-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "cd .. && node node_modules/vite/bin/vite.js --config website/vite.config.ts",
    "build": "cd .. && node node_modules/vite/bin/vite.js build --config website/vite.config.ts",
    "copy-download": "cd .. && \"%SystemRoot%\\System32\\WindowsPowerShell\\v1.0\\powershell.exe\" -NoProfile -ExecutionPolicy Bypass -File website/scripts/copy-download.ps1",
    "preview": "cd .. && node node_modules/vite/bin/vite.js preview --config website/vite.config.ts",
    "typecheck": "node ../node_modules/typescript/bin/tsc -p tsconfig.json"
  }
}
